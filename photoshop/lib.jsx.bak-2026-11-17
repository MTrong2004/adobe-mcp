// ---- runner ----
function __mcpRun(title, args, fn, hist) {
  var ru = null, dd = null, res;
  try {
    ru = app.preferences.rulerUnits; $.global.__mcpRU = ru; app.preferences.rulerUnits = Units.PIXELS;
    dd = app.displayDialogs; app.displayDialogs = DialogModes.NO;
    if (hist && app.documents.length) {
      $.global.__mcpFn = function () { $.global.__mcpRes = fn(args); };
      $.global.__mcpRes = undefined;
      app.activeDocument.suspendHistory(title, "$.global.__mcpFn()");
      res = $.global.__mcpRes;
    } else res = fn(args);
    return __J({ success: true, result: res === undefined ? null : res });
  } catch (e) {
    return __J({ success: false, error: String(e && e.message ? e.message : e), line: e && e.line ? e.line : null });
  } finally {
    try { if (ru !== null) app.preferences.rulerUnits = ru; app.displayDialogs = (dd === null || dd === DialogModes.NO) ? DialogModes.ALL : dd; } catch (_) {}
  }
}

