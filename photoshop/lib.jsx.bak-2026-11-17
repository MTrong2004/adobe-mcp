  for (i = 0; i < 4; i++) rect.putUnitDouble(cTID("#Pxl"), __px(b[i]));
  for (i = 0; i < 4; i++) { quad.putUnitDouble(cTID("#Pxl"), C[i][0]); quad.putUnitDouble(cTID("#Pxl"), C[i][1]); }
  desc.putList(sTID("rectangle"), rect); desc.putList(sTID("quadrilateral"), quad);
  executeAction(cTID("Trnf"), desc, DialogModes.NO);
